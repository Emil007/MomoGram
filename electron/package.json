{
  "name": "momogram",
  "productName": "MomoGram",
  "version": "0.8.0",
  "description": "One nonogram player for all the nonogram games you own",
  "main": "main.cjs",
  "license": "MIT",
  "author": "MomoGram contributors",
  "build": {
    "appId": "io.github.momogram",
    "productName": "MomoGram",
    "files": [
      "main.cjs",
      "icon.png",
      "web/**"
    ],
    "directories": {
      "output": "../dist/desktop"
    },
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "artifactName": "MomoGram-${version}-Windows-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Game",
      "artifactName": "MomoGram-${version}-Linux-${arch}.${ext}",
      "executableName": "momogram"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.puzzle-games",
      "identity": null,
      "artifactName": "MomoGram-${version}-macOS-${arch}.${ext}"
    },
    "artifactName": "MomoGram-${version}-${os}-${arch}.${ext}",
    "publish": null,
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "MomoGram-${version}-Windows-${arch}-Setup.${ext}"
    },
    "fileAssociations": [
      {
        "ext": "nds",
        "name": "Nintendo DS ROM",
        "role": "Viewer"
      }
    ]
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "repository": "https://github.com/Emil007/MomoGram"
}